# Runtime
APP_ENV=development
PORT=8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
READ_HEADER_TIMEOUT=5s

# PostgreSQL / Supabase pooler
# Use the connection mode and port appropriate for the deployment workload.
DATABASE_URL=postgresql://postgres:<password>@<host>:6543/postgres?sslmode=require
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
# Enable only after testing against a transaction pooler that needs simple protocol.
DATABASE_SIMPLE_PROTOCOL=false
DATABASE_CONNECT_TIMEOUT=10s
HEALTHCHECK_TIMEOUT=2s

# Comma-separated browser origins. Set this explicitly outside local development.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Authentication is intentionally not configured yet. Before adding JWT middleware,
# decide whether this Supabase project uses asymmetric JWKS keys or legacy HS256.
